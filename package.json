{
  "name": "my-app",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "build": "tsc && vite build",
    "preview": "vite preview",
    "dev": "npx concurrently -n API,WEB -c auto \"npm:dev:api\" \"cd client && npm run dev\"",
    "dev:all": "npx concurrently \"npm run start:dev\" \"cd client && npm run dev\"",
  "dev:all:public": "npx concurrently -n API,WEB -c auto \"PORT=3000 npm run start:dev\" \"cd client && npm run dev\"",
    "client:build": "cd client && npm run build",
    "setup": "npm install && cd client && npm install && cd .. && npx prisma generate && npx prisma migrate dev --name init && npm run seed",
    "build:backend": "tsc -p tsconfig.json",
    "start": "npm run build:backend && node dist/main.js",
    "start:dev": "npx tsx src/main.ts",
    "backend:start": "npx tsx src/main.ts",
    "backend:dev": "nodemon --exec ts-node src/main.ts",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:reset": "prisma migrate reset --force && npm run seed",
    "seed": "npx tsx ./prisma/seed.ts",
    "seed:compile": "if not exist dist\\prisma mkdir dist\\prisma && npx tsc prisma/seed.ts --outDir dist --target es2020 --module commonjs --esModuleInterop --skipLibCheck && node dist/prisma/seed.js",
    "test": "jest --runInBand",
    "test:e2e": "jest --runInBand --testPathPattern=e2e-spec",
    "dev:api": "nodemon --watch src --exec \"npx tsx\" src/main.ts"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": ".",
    "testRegex": ".*(\\.e2e-spec|\\.spec)\\.ts$",
    "transform": { "^.+\\.(t|j)s$": "ts-jest" },
    "collectCoverageFrom": ["src/**/*.(t|j)s"],
    "coverageDirectory": "coverage",
    "testEnvironment": "node",
    "testPathIgnorePatterns": ["/node_modules/", "src/__tests__/"]
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    
    "@nestjs/platform-express": "^11.1.6",
    "@prisma/client": "^6.16.2",
    
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "multer": "^1.4.5-lts.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    
    "@types/jest": "^29.2.0",
    
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "jest": "^29.0.0",
    "nodemon": "^3.1.10",
    "prisma": "^6.16.2",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.2",
    "@types/multer": "^1.4.7",
    "supertest": "^7.1.1",
    "@types/supertest": "^2.0.16",
    "@nestjs/testing": "^11.1.6"
  }
}
